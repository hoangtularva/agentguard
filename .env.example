# --- Database -------------------------------------------------------------
# Leave DATABASE_URL empty to use embedded PGlite (PostgreSQL in WASM) stored in PGLITE_DIR.
# Docker Compose sets DATABASE_URL to its own PostgreSQL container.
DATABASE_URL=
PGLITE_DIR=.data/pglite
POSTGRES_PASSWORD=change-me-local-only

# --- Demo identity --------------------------------------------------------
# HMAC key for the demo identity cookie (>= 16 chars). Generate: openssl rand -hex 32
AUTH_SECRET=

# --- Optional LLM planner (Claude) ----------------------------------------
# Without a key the Playground and benchmark use the deterministic simulated agent.
ANTHROPIC_API_KEY=
CALLWRIT_LLM_MODEL=claude-opus-5-5
CALLWRIT_LLM_EFFORT=low
